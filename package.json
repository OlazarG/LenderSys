{
  "name": "usurerosystem",
  "version": "1.0.0",
  "description": "Sistema Avanzado de Gestión de Préstamos y Cobros",
  "author": {
    "name": "Sistemas Olazar",
    "email": "contacto@sistemasolazar.com"
  },
  "homepage": "https://sistemasolazar.com/usurero",
  "main": "electron_main.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "init-db": "node scripts/init_db.js",
    "electron": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.sistemasolazar.usurero",
    "productName": "UsureroSystem",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "Sistemas Olazar <contacto@sistemasolazar.com>"
    },
    "files": [
      "**/*",
      "!dist"
    ]
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-cron": "^3.0.3",
    "pg": "^8.11.5",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "nodemon": "^3.1.0"
  }
}
